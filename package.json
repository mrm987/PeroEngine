{
  "name": "pero-engine-desktop",
  "version": "0.1.0",
  "description": "PeroEngine - AI Assistant Desktop App",
  "main": "electron/main.js",
  "author": "PeroEngine Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "node electron/dev.js",
    "dev:quick": "electron . --dev",
    "build": "node electron/build.js",
    "build:win": "node electron/build.js --win",
    "build:mac": "node electron/build.js --mac",
    "build:linux": "node electron/build.js --linux"
  },
  "build": {
    "appId": "com.peroengine.desktop",
    "productName": "PeroEngine",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "src/**/*",
      "config.yaml",
      "run_server.py",
      "requirements.txt"
    ],
    "extraResources": [
      {
        "from": "python-runtime",
        "to": "python",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "electron/assets/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "electron/assets/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "electron/assets/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "fix-path": "^4.0.0"
  }
}
